# Copia este archivo a .env (o define estas variables en tu proveedor de hosting).
# Ninguna es obligatoria para desarrollo local: sin nada configurado, el
# sistema usa SQLite y JWT_SECRET de desarrollo, y simplemente no podrá
# cobrar suscripción ni transmitir facturas a un proveedor certificado.

# --- Núcleo ---
PORT=4000
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# --- Base de datos (producción) ---
# Sin definir, se usa SQLite local (server/db/restaurant.db).
# DATABASE_URL=postgres://usuario:clave@host:5432/basededatos
# DATABASE_SSL=false

# --- Suscripción SaaS (Stripe) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_STARTER=price_...
# STRIPE_PRICE_ID_PRO=price_...
# APP_URL=https://tu-dominio.com
# ENFORCE_BILLING=true

# Nota: las credenciales del proveedor de facturación electrónica (Alegra,
# Facturama, Nubefact) se configuran por restaurante desde la app
# (Admin → Facturación), no aquí.
